<header class="{% if page.url === "/" %}intro--home {% endif %}[ intro ] [ pad-top-900 pad-bottom-max ]">
  <div class="[ inner-wrapper ] [ sf-flow ]">
    {% if page.url === '/' %}
      <img class="intro__portrait" src="/images/hind-portrait.jpg" alt="Hind Mukhtar" width="1290" height="1217" fetchpriority="high">
    {% endif %}
    <div class="intro__panel">
      {% if page.url === '/' %}<div class="terminal-bar" aria-hidden="true"><i></i><i></i><i></i></div>{% endif %}
    <h1 class="[ intro__heading{{ ' intro__heading--compact' if page.url === '/' }} ] [ text-800 md:text-900 leading-tight ] [ p-name ]">{{ introHeading }}</h1>
    {% if introSummary %}
      <div class="[ intro__summary ] [ sf-flow ] [ leading-mid measure-short ]">{{ introSummary | safe }}</div>
    {% endif %}
    </div>
  </div>
</header>
